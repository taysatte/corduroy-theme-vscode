{
  "name": "corduroy-theme-vscode",
  "displayName": "Corduroy for VSCode",
  "description": "Embrace vintage warmth, soft textures, and a touch of retro flair.",
  "version": "1.2.7",
  "publisher": "TaylorSattenfield",
  "license": "MIT",
  "author": {
    "name": "Taylor Sattenfield",
    "email": "taylor.sattenfield@gmail.com",
    "url": "https://github.com/taysatte"
  },
  "icon": "assets/icons/icon-bg.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/taysatte/corduroy-theme-vscode"
  },
  "bugs": {
    "url": "https://github.com/alexandernanberg/horizon-theme-vscode/issues"
  },
  "galleryBanner": {
    "color": "#1d1920",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "dark",
    "warm",
    "corduroy",
    "vintage",
    "retro",
    "soft",
    "textures",
    "warmth",
    "elegant",
    "comfortable",
    "cozy"
  ],
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "contributes": {
    "themes": [
      {
        "label": "Corduroy",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy.json"
      },
      {
        "label": "Corduroy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-dark.json"
      },
      {
        "label": "Corduroy Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-italic.json"
      },
      {
        "label": "Corduroy Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-dark-italic.json"
      }
    ],
    "markdown.previewStyles": [
      "./markdown-preview.css"
    ]
  }
}
