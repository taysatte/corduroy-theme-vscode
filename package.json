{
  "name": "corduroy-theme",
  "displayName": "Corduroy Theme",
  "description": "Embrace vintage warmth, soft textures, and a touch of retro flair.",
  "version": "1.4.0",
  "publisher": "taysatte",
  "license": "MIT",
  "author": {
    "name": "Taylor Sattenfield",
    "email": "taylor.sattenfield@gmail.com",
    "url": "https://github.com/taysatte"
  },
  "icon": "assets/icons/icon-bg.png",
  "homepage": "https://github.com/taysatte/corduroy-theme-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/taysatte/corduroy-theme-vscode"
  },
  "bugs": {
    "url": "https://github.com/taysatte/corduroy-theme-vscode/issues"
  },
  "galleryBanner": {
    "color": "#1d1920",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "dark",
    "warm",
    "corduroy",
    "vintage",
    "retro",
    "soft",
    "textures",
    "warmth",
    "elegant",
    "comfortable",
    "cozy"
  ],
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build:themes": "node scripts/refactor-workbench-colors.mjs && node scripts/refactor-token-colors.mjs",
    "package": "pnpm run build:themes && vsce package",
    "publish:marketplace": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.1",
    "prettier": "^3.5.3"
  },
  "contributes": {
    "themes": [
      {
        "label": "Corduroy",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy.json"
      },
      {
        "label": "Corduroy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-dark.json"
      },
      {
        "label": "Corduroy (italic)",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-italic.json"
      },
      {
        "label": "Corduroy Dark (italic)",
        "uiTheme": "vs-dark",
        "path": "./themes/corduroy-dark-italic.json"
      }
    ],
    "markdown.previewStyles": [
      "./markdown-preview.css"
    ]
  }
}
